# ButtonSpa Environment Variables
# Copy this file to .env and fill in your values

# OpenRouter API Key (required — powers all AI transcription)
# Get your key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Square payment settings (for $9/year premium unlock)
# Use SQUARE_ENVIRONMENT=sandbox while testing, then production for launch.
SQUARE_ENVIRONMENT=sandbox
SQUARE_API_VERSION=2026-01-22
SQUARE_ACCESS_TOKEN=your_square_access_token_here
SQUARE_LOCATION_ID=your_square_location_id_here
SQUARE_WEBHOOK_SIGNATURE_KEY=your_square_webhook_signature_key_here
SQUARE_WEBHOOK_NOTIFICATION_URL=http://localhost:8000/api/square/webhook
