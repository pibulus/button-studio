{
  "description": "ButtonSpa - Team-shared project settings",
  "permissions": {
    "allow": [
      "Bash(deno:*)",
      "Bash(git:*)",
      "Bash(npm:*)",
      "Bash(deployctl:*)"
    ],
    "deny": [
      "**/.env*",
      "**/secrets/**",
      "**/*.key",
      "**/*.pem"
    ]
  },
  "environment": {
    "PROJECT_NAME": "ButtonSpa",
    "DENO_VERSION": "1.46.3"
  }
}
